{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "OpenTelemetry": {
      "LogLevel": {
        "Default": "Warning",
        "SongVault": "Information",
        "SongVault.Infrastructure.Email.LogEmailSender": "None"
      }
    }
  },
  "AllowedHosts": "*",
  "Email": {
    "Provider": "Log",
    "FromAddress": "no-reply@songvault.local",
    "FromName": "SongVault"
  },
  "Billing": {
    "Provider": "None"
  }
}