dotenv
# Copier ce fichier en .env (NON versionné) et adapter les valeurs.
# Mot de passe SA : 8 caractères minimum, majuscule, minuscule, chiffre et symbole.
# Évitez le caractère $ (interprété par Compose).
MSSQL_SA_PASSWORD=ChangezMoi!2026
# E-mails (ADR 0009). Log = écrits dans `docker compose logs api`, rien n'est envoyé.
# Pour envoyer vraiment : EMAIL_PROVIDER=Brevo, une adresse d'expéditeur validée chez Brevo et la clé d'API.
EMAIL_PROVIDER=Log
# EMAIL_FROM=no-reply@ton-domaine.fr
# BREVO_API_KEY=